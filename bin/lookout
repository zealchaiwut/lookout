#!/usr/bin/env python3
"""Entry point for a lookout run against a named target."""
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

import yaml

REPO_ROOT = Path(subprocess.check_output(
    ["git", "rev-parse", "--show-toplevel"],
    cwd=Path(__file__).parent,
    text=True,
).strip())

TARGETS_YAML = REPO_ROOT / "targets.yaml"
LINT_SCRIPT = REPO_ROOT / ".claude" / "skills" / "lookout" / "scripts" / "lint.py"

sys.path.insert(0, str(REPO_ROOT))
import gather as gather_module
import pack as pack_module
import all_runner as all_runner_module
import promote as promote_module
import derive as derive_module


def load_targets():
    with open(TARGETS_YAML) as f:
        data = yaml.safe_load(f)
    return list(data.get("targets", {}).keys())


def _print_summary_table(summary: dict) -> None:
    col_w = 12
    count_w = 6
    header = f"{'source':<{col_w}}  {'status':<{col_w}}  {'count':>{count_w}}"
    sep = "-" * len(header)
    print()
    print("--- Gather Summary ---")
    print(header)
    print(sep)
    for source in ("commander", "notion", "journal"):
        entry = summary.get(source, {"status": "absent", "count": 0})
        status = entry.get("status", "absent")
        count = entry.get("count", 0)
        print(f"{source:<{col_w}}  {status:<{col_w}}  {count:>{count_w}}")
    print()


def commit_run(target, timestamp, snapshot_branch=None):
    _snapshot_branch = snapshot_branch or all_runner_module._load_snapshot_branch(TARGETS_YAML)
    current_branch = all_runner_module._get_current_branch(REPO_ROOT)

    if current_branch != _snapshot_branch:
        print(
            f"lookout: skipping commit — current branch is '{current_branch}', "
            f"expected '{_snapshot_branch}'. Vault files written but not committed."
        )
        all_runner_module._update_manifest_committed(target, REPO_ROOT, committed=False)
        return 0

    # vault/projects/*/raw/ is in .gitignore; -f force-adds snapshot files
    vault_path = f"vault/projects/{target}/raw"
    subprocess.run(["git", "add", "-f", vault_path], cwd=REPO_ROOT, check=True)
    # Derived notes (situation/capability/drift/todo-view, map.md, ideas index)
    # are not ignored, but they still have to be staged to land in the commit.
    subprocess.run(["git", "add", "vault"], cwd=REPO_ROOT, check=False)
    result = subprocess.run(
        ["git", "commit", "-m", f"lookout({target}): snapshot {timestamp}"],
        cwd=REPO_ROOT,
    )
    all_runner_module._update_manifest_committed(
        target, REPO_ROOT, committed=(result.returncode == 0)
    )
    return result.returncode


def main():
    # Dispatch --all flag: run every registered target with failure isolation
    if len(sys.argv) >= 2 and sys.argv[1] == "--all":
        lock_path = Path(os.environ.get("LOOKOUT_LOCK_PATH", "/tmp/lookout-all.lock"))
        targets_yaml = Path(os.environ.get("LOOKOUT_TARGETS_YAML", str(TARGETS_YAML)))
        lint_script = Path(os.environ.get("LOOKOUT_LINT_SCRIPT", str(LINT_SCRIPT)))
        _, any_failed = all_runner_module.run_all(
            targets_yaml=targets_yaml,
            lint_script=lint_script,
            lock_path=lock_path,
            repo_root=REPO_ROOT,
        )
        sys.exit(1 if any_failed else 0)

    # Dispatch promote subcommand
    if len(sys.argv) >= 2 and sys.argv[1] == "promote":
        import argparse
        parser = argparse.ArgumentParser(prog="lookout promote")
        parser.add_argument("inbox_file", help="Path to the inbox file")
        parser.add_argument("--type", dest="promote_type", required=True,
                            choices=["idea", "sprint"])
        parser.add_argument("--vault", default=str(REPO_ROOT / "vault"))
        # Parse only the args after "promote"
        sub_args = parser.parse_args(sys.argv[2:])
        try:
            result = promote_module.promote(
                Path(sub_args.inbox_file),
                sub_args.promote_type,
                vault_dir=Path(sub_args.vault),
            )
            print(f"Promoted: {result}")
        except FileNotFoundError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            sys.exit(1)
        except promote_module.PromoteError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            sys.exit(1)
        sys.exit(0)

    # Dispatch pack subcommand before any other processing
    if len(sys.argv) >= 2 and sys.argv[1] == "pack":
        if len(sys.argv) < 3:
            print("Usage: bin/lookout pack <target...>", file=sys.stderr)
            sys.exit(1)
        targets = sys.argv[2:]
        try:
            pack_path = pack_module.generate_pack(
                targets=list(targets),
                vault_dir=REPO_ROOT / "vault",
            )
            print(f"Pack written: {pack_path}")
        except pack_module.UnknownTargetError:
            sys.exit(1)
        sys.exit(0)

    valid_targets = load_targets()

    if len(sys.argv) < 2 or not sys.argv[1]:
        print("Usage: bin/lookout <target>", file=sys.stderr)
        print(f"Valid targets: {', '.join(valid_targets)}", file=sys.stderr)
        sys.exit(1)

    target = sys.argv[1]

    if target not in valid_targets:
        print(f"Error: unknown target '{target}'", file=sys.stderr)
        print("Valid targets:", file=sys.stderr)
        for t in valid_targets:
            print(f"  {t}", file=sys.stderr)
        sys.exit(1)

    timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    # Run gather — always exits 0 on source unavailability
    gather_module.REPO_ROOT = REPO_ROOT
    gather_module.TARGETS_YAML = TARGETS_YAML
    try:
        summary = gather_module.gather(target)
    except SystemExit as exc:
        sys.exit(exc.code)

    _print_summary_table(summary)

    # Derive — turn the snapshot into the notes a reader actually reads.
    # Runs before lint so lint validates this run's output, not the last one's.
    vault_dir = REPO_ROOT / "vault"
    derive_results = derive_module.derive_target(target, vault_dir)
    derive_module.print_summary(f"Derive: {target}", derive_results)
    vault_results = derive_module.derive_vault(vault_dir)
    derive_module.print_summary("Derive: vault-wide", vault_results)

    lint_result = subprocess.run(
        [sys.executable, str(LINT_SCRIPT)], cwd=REPO_ROOT,
    )
    lint_exit = lint_result.returncode

    if lint_exit != 0:
        print(f"lookout: lint failed (exit {lint_exit})", file=sys.stderr)

    commit_run(target, timestamp)

    sys.exit(0)


if __name__ == "__main__":
    main()
