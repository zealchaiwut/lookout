    },
    {
      "path": "/api/job/{id}",
      "description": "Poll a job's status",
      "source": "README.md",
      "example": "curl http://localhost:8000/api/job/{id}"
    },
    {
      "path": "/api/jobs",
      "description": "List all jobs (session-scoped)",
